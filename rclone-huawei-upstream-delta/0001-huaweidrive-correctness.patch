+		t.Run(test.name, func(t *testing.T) {
+			o := &Object{remote: test.remote, mimeType: test.mimeType, sha256: apiHash, size: 1}
+			got, err := o.Hash(ctx, hash.SHA256)
+			if err != nil {
+				t.Fatalf("Hash returned error: %v", err)
+			}
+			if got != test.want {
+				t.Fatalf("Hash = %q, want %q", got, test.want)
+			}
+		})
+	}
+}
