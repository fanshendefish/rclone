+		}
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("reading request body: %v", err)
+		}
+		request++
+		switch request {
+		case 1:
+			w.Header().Set("Range", "bytes=0-9")
+			w.WriteHeader(308)
+		case 2:
+			w.Header().Set("Range", "bytes=0-19")
+			w.WriteHeader(308)
+		case 3:
+			if len(body) != 0 || r.Header.Get("Content-Length") != "0" {
+				t.Errorf("status query body length=%d Content-Length=%q", len(body), r.Header.Get("Content-Length"))
+			}
+			if got := r.Header.Get("Content-Range"); got != "" {
+				t.Errorf("status query unexpectedly sent Content-Range %q", got)
+			}
+			w.Header().Set("Range", "bytes=0-14")
+			w.WriteHeader(308)
+		case 4:
+			if got := r.Header.Get("Content-Range"); got != "bytes 15-19/20" {
+				t.Errorf("resent Content-Range = %q", got)
+			}
+			if !bytes.Equal(body, data[15:]) {
+				t.Errorf("resent body = %q", body)
+			}
+			writeUploadedFile(t, w, int64(len(data)))
+		default:
+			t.Errorf("unexpected request %d", request)
+		}
+	})
+
+	err := obj.uploadResume(ctx, bytes.NewReader(data), "test.bin", "root", int64(len(data)), time.Time{}, nil)
+	if err != nil {
+		t.Fatalf("uploadResume returned error: %v", err)
+	}
+	if request != 4 {
+		t.Fatalf("session requests = %d, want 4", request)
+	}
+}
