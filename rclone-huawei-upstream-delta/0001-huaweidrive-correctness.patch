+func TestResumeOffsetFromRange(t *testing.T) {
+	tests := []struct {
+		name       string
+		rangeValue string
+		size       int64
+		want       int64
+		wantErr    bool
+	}{
+		{name: "equals form", rangeValue: "bytes=0-9", size: 20, want: 10},
+		{name: "space form", rangeValue: "bytes 0-19", size: 20, want: 20},
+		{name: "case and whitespace", rangeValue: " Bytes=0-4 ", size: 10, want: 5},
+		{name: "missing", size: 20, wantErr: true},
+		{name: "wrong unit", rangeValue: "items=0-9", size: 20, wantErr: true},
+		{name: "non cumulative", rangeValue: "bytes=10-19", size: 20, wantErr: true},
+		{name: "past declared size", rangeValue: "bytes=0-20", size: 20, wantErr: true},
+		{name: "malformed", rangeValue: "bytes=abc", size: 20, wantErr: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := resumeOffsetFromRange(test.rangeValue, test.size)
+			if test.wantErr {
+				if err == nil {
+					t.Fatalf("resumeOffsetFromRange(%q, %d) unexpectedly succeeded with %d", test.rangeValue, test.size, got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("resumeOffsetFromRange(%q, %d) returned error: %v", test.rangeValue, test.size, err)
+			}
+			if got != test.want {
+				t.Fatalf("resumeOffsetFromRange(%q, %d) = %d, want %d", test.rangeValue, test.size, got, test.want)
+			}
+		})
+	}
+}
