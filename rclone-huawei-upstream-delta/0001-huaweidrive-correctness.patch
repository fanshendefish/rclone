+func TestUploadResumeResendsCurrentChunkSuffix(t *testing.T) {
+	ctx := context.Background()
+	data := []byte("0123456789abcdefghij")
+	request := 0
+	var server *httptest.Server
+	obj, server := newResumeTestObject(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/files" {
+			if got := r.URL.Query().Get("autoRename"); got != "false" {
+				t.Errorf("autoRename query = %q, want false", got)
+			}
+			writeResumeInit(t, w, server.URL, 10)
+			return
+		}
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("reading request body: %v", err)
+		}
+		request++
+		switch request {
+		case 1:
+			if got := r.Header.Get("Content-Range"); got != "bytes 0-9/20" {
+				t.Errorf("first Content-Range = %q", got)
+			}
+			if !bytes.Equal(body, data[:10]) {
+				t.Errorf("first body = %q", body)
+			}
+			w.Header().Set("Range", "bytes=0-3")
+			w.WriteHeader(308)
+		case 2:
+			if got := r.Header.Get("Content-Range"); got != "bytes 4-9/20" {
+				t.Errorf("suffix Content-Range = %q", got)
+			}
+			if !bytes.Equal(body, data[4:10]) {
+				t.Errorf("suffix body = %q", body)
+			}
+			w.Header().Set("Range", "bytes=0-9")
+			w.WriteHeader(308)
+		case 3:
+			if got := r.Header.Get("Content-Range"); got != "bytes 10-19/20" {
+				t.Errorf("second chunk Content-Range = %q", got)
+			}
+			if !bytes.Equal(body, data[10:]) {
+				t.Errorf("second chunk body = %q", body)
+			}
+			writeUploadedFile(t, w, int64(len(data)))
+		default:
+			t.Errorf("unexpected request %d", request)
+		}
+	})
+
+	err := obj.uploadResume(ctx, bytes.NewReader(data), "test.bin", "root", int64(len(data)), time.Time{}, nil)
+	if err != nil {
+		t.Fatalf("uploadResume returned error: %v", err)
+	}
+	if request != 3 {
+		t.Fatalf("data requests = %d, want 3", request)
+	}
+}
+
+func TestUploadResumeFinalQueryResendsLastChunkSuffix(t *testing.T) {
+	ctx := context.Background()
+	data := []byte("0123456789abcdefghij")
+	request := 0
+	var server *httptest.Server
+	obj, server := newResumeTestObject(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/files" {
+			writeResumeInit(t, w, server.URL, 10)
