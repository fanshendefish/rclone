+// resumeOffsetFromRange returns the first byte not yet acknowledged by the
+// resumable upload endpoint. Huawei returns a cumulative Range such as
+// "bytes=0-1048575" (some deployments use a space instead of '=') on 308.
+// Missing or ambiguous state is rejected so callers never guess which bytes
+// the server persisted.
+func resumeOffsetFromRange(rangeValue string, size int64) (int64, error) {
+	rangeValue = strings.TrimSpace(rangeValue)
+	if rangeValue == "" {
+		return 0, errors.New("308 response did not include a Range header")
+	}
+
+	lower := strings.ToLower(rangeValue)
+	var byteRange string
+	switch {
+	case strings.HasPrefix(lower, "bytes="):
+		byteRange = strings.TrimSpace(rangeValue[len("bytes="):])
+	case strings.HasPrefix(lower, "bytes "):
+		byteRange = strings.TrimSpace(rangeValue[len("bytes "):])
+	default:
+		return 0, fmt.Errorf("invalid resumable Range %q", rangeValue)
+	}
+
+	parts := strings.Split(byteRange, "-")
+	if len(parts) != 2 {
+		return 0, fmt.Errorf("invalid resumable Range %q", rangeValue)
+	}
+	start, err := strconv.ParseInt(strings.TrimSpace(parts[0]), 10, 64)
+	if err != nil || start != 0 {
+		return 0, fmt.Errorf("invalid cumulative resumable Range %q", rangeValue)
+	}
+	end, err := strconv.ParseInt(strings.TrimSpace(parts[1]), 10, 64)
+	if err != nil || end < start || end >= size {
+		return 0, fmt.Errorf("invalid resumable Range %q for size %d", rangeValue, size)
+	}
+	return end + 1, nil
+}
