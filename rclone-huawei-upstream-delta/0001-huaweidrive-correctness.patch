+func TestListDirectoryUsesNextCursorAndPageSize100(t *testing.T) {
+	ctx := context.Background()
+	requests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests++
+		if got := r.URL.Query().Get("pageSize"); got != "100" {
+			t.Errorf("pageSize = %q, want 100", got)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		switch requests {
+		case 1:
+			if got := r.URL.Query().Get("cursor"); got != "" {
+				t.Errorf("first cursor = %q, want empty", got)
+			}
+			files := make([]api.File, 100)
+			for i := range files {
+				files[i] = api.File{ID: fmt.Sprintf("id-%d", i), FileName: fmt.Sprintf("file-%d", i), MimeType: "application/octet-stream"}
+			}
+			if err := json.NewEncoder(w).Encode(api.FileList{Files: files, NextCursor: "cursor-2"}); err != nil {
+				t.Errorf("encoding first page: %v", err)
+			}
+		case 2:
+			if got := r.URL.Query().Get("cursor"); got != "cursor-2" {
+				t.Errorf("second cursor = %q, want cursor-2", got)
+			}
+			if err := json.NewEncoder(w).Encode(api.FileList{Files: []api.File{{ID: "id-100", FileName: "file-100", MimeType: "application/octet-stream"}}}); err != nil {
+				t.Errorf("encoding second page: %v", err)
+			}
+		default:
+			t.Errorf("unexpected listing request %d", requests)
+		}
+	}))
+	defer server.Close()
+	f := &Fs{
+		srv:   rest.NewClient(server.Client()).SetRoot(server.URL),
+		pacer: fs.NewPacer(ctx, pacer.NewDefault(pacer.MinSleep(0), pacer.MaxSleep(0))),
+		opt:   Options{ListChunk: 1000}, // Old configs are clamped safely.
+	}
+	count := 0
+	found, err := f.listDirectoryWithFilter(ctx, "root", NewQueryFilter(), func(item *api.File) bool {
+		count++
+		return false
+	})
+	if err != nil {
+		t.Fatalf("listDirectoryWithFilter returned error: %v", err)
+	}
+	if found {
+		t.Fatal("listDirectoryWithFilter unexpectedly reported a match")
+	}
+	if requests != 2 || count != 101 {
+		t.Fatalf("requests=%d count=%d, want 2 and 101", requests, count)
+	}
+}
